<Window x:Class="HEManager.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HE Manager · Windows 原生播放原型">
<Grid x:Name="Root" Background="#101216" Loaded="OnLoaded" KeyDown="OnKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="12" Padding="20,12" Background="#1D2129">
    <TextBlock Text="HE" Foreground="#A6B8FF" FontSize="26" FontWeight="Bold"/>
    <TextBlock Text="Manager" Foreground="White" FontSize="24"/>
    <TextBlock Text="WN-01 · 内嵌播放验证" Foreground="#A9B1C3" VerticalAlignment="Center" Margin="12,0"/>
    <Button Content="打开测试片" Click="OpenSample"/><Button Content="打开视频" Click="OpenFile"/>
  </StackPanel>
  <Grid Grid.Row="1" x:Name="VideoArea" Background="Black">
    <SwapChainPanel x:Name="Video" SizeChanged="VideoSizeChanged"/>
    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Padding="12,8" Background="#C0101216" CornerRadius="6">
      <TextBlock x:Name="Diagnostics" Text="正在初始化 D3D11…" Foreground="#D6DFFF" FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="1000"/>
    </Border>
    <Border VerticalAlignment="Bottom" Margin="16" Padding="16,10" Background="#E6222731" CornerRadius="10">
      <StackPanel Spacing="6">
        <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="SeekChanged"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="播放 / 暂停" Click="Pause"/><TextBlock x:Name="Position" Text="00:00 / 00:00" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text="音量" Foreground="White" VerticalAlignment="Center"/><Slider x:Name="Volume" Width="100" Minimum="0" Maximum="100" Value="70" ValueChanged="VolumeChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="Preset" SelectedIndex="0" SelectionChanged="PresetChanged"><ComboBoxItem Content="原画" Tag="off"/><ComboBoxItem Content="Anime4K 效率" Tag="efficiency"/><ComboBoxItem Content="Anime4K 质量" Tag="quality"/></ComboBox>
            <Button Content="全屏 · F11" Click="Fullscreen"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
</Window>
