<Window x:Class="HEManager.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HE Manager">
<Grid x:Name="ShellRoot" Loaded="ShellLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
<NavigationView x:Name="Navigation" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" IsSettingsVisible="False" SelectionChanged="NavigationChanged">
  <NavigationView.MenuItems>
    <NavigationViewItem x:Name="AccountNavigation" AutomationProperties.AutomationId="NavigateAccount" Content="连接与账号" Icon="Contact" Tag="account"/>
    <NavigationViewItem x:Name="PlayerNavigation" AutomationProperties.AutomationId="NavigatePlayer" Content="本地播放" Icon="Play" Tag="player"/>
  </NavigationView.MenuItems>
  <NavigationView.FooterMenuItems><NavigationViewItem AutomationProperties.AutomationId="NavigateSettings" Content="设置" Icon="Setting" Tag="settings"/></NavigationView.FooterMenuItems>
  <Grid>
    <ScrollViewer x:Name="AccountPage" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Margin="32" Spacing="20">
        <StackPanel Spacing="6"><TextBlock Text="HE Manager" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="连接你的媒体库服务器" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="服务器" FontSize="20" FontWeight="SemiBold"/>
            <TextBox x:Name="ServerAddressBox" AutomationProperties.AutomationId="ServerAddress" Header="服务器地址" PlaceholderText="http://服务器地址:8011" TextChanged="ServerAddressChanged"/>
            <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectServer" Content="连接 / 重新连接" Click="ConnectClicked"/>
            <TextBlock x:Name="ActiveServerText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ProgressRing x:Name="ConnectionProgress" Width="24" Height="24" HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed"/>
            <TextBlock x:Name="ConnectionMessage" AutomationProperties.AutomationId="ConnectionMessage" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          </StackPanel>
        </Border>
        <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock x:Name="AccountHeading" Text="账号登录" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel x:Name="LoginFields" Spacing="12">
              <TextBox x:Name="UsernameBox" AutomationProperties.AutomationId="Username" Header="用户名"/>
              <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="Password" Header="密码"/>
              <TextBlock Text="登录信息由 Windows 当前用户保护，密码不会保存。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <Button x:Name="LoginButton" AutomationProperties.AutomationId="Login" Content="登录" Click="LoginClicked" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="SignedInText" AutomationProperties.AutomationId="SignedInUser" TextWrapping="Wrap"/>
            <Button x:Name="LogoutButton" AutomationProperties.AutomationId="Logout" Content="退出账号" Click="LogoutClicked" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Margin="32" Spacing="24">
        <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold"/>
        <ComboBox x:Name="ThemeChoice" AutomationProperties.AutomationId="Theme" Header="外观" SelectionChanged="ThemeChanged" Width="240">
          <ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/>
        </ComboBox>
        <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
<Grid x:Name="Root" Visibility="Collapsed" Background="#101216" Loaded="OnLoaded">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="Chrome" Orientation="Horizontal" Spacing="12" Padding="20,12" Background="#1D2129">
    <TextBlock Text="HE" Foreground="#A6B8FF" FontSize="26" FontWeight="Bold"/>
    <TextBlock Text="Manager" Foreground="White" FontSize="24"/>
    <TextBlock Text="WN-01 · 内嵌播放验证" Foreground="#A9B1C3" VerticalAlignment="Center" Margin="12,0"/>
    <Button x:Name="SampleButton" AutomationProperties.AutomationId="OpenSample" Content="打开测试片" Click="OpenSample"/><Button AutomationProperties.AutomationId="OpenFile" Content="打开视频" Click="OpenFile"/>
  </StackPanel>
  <Grid Grid.Row="1" x:Name="VideoArea" Background="Black">
    <SwapChainPanel x:Name="Video" SizeChanged="VideoSizeChanged"/>
    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Padding="12,8" Background="#C0101216" CornerRadius="6">
      <TextBlock x:Name="Diagnostics" AutomationProperties.AutomationId="PlaybackDiagnostics" Text="正在初始化 D3D11…" Foreground="#D6DFFF" FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="1000"/>
    </Border>
    <Border VerticalAlignment="Bottom" Margin="16" Padding="16,10" Background="#E6222731" CornerRadius="10">
      <StackPanel Spacing="6">
        <Slider x:Name="Seek" AutomationProperties.AutomationId="Seek" AutomationProperties.Name="播放进度" Minimum="0" Maximum="1" ValueChanged="SeekChanged"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="PauseButton" AutomationProperties.AutomationId="Pause" Content="播放 / 暂停" Click="Pause"/><TextBlock x:Name="Position" Text="00:00 / 00:00" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text="音量" Foreground="White" VerticalAlignment="Center"/><Slider x:Name="Volume" AutomationProperties.AutomationId="Volume" AutomationProperties.Name="音量" Width="100" Minimum="0" Maximum="100" Value="70" ValueChanged="VolumeChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="Preset" AutomationProperties.AutomationId="Preset" SelectedIndex="0" SelectionChanged="PresetChanged"><ComboBoxItem Content="原画" AutomationProperties.AutomationId="PresetOff" Tag="off"/><ComboBoxItem Content="Anime4K 效率" AutomationProperties.AutomationId="PresetEfficiency" Tag="efficiency"/><ComboBoxItem Content="Anime4K 质量" AutomationProperties.AutomationId="PresetQuality" Tag="quality"/></ComboBox>
            <Button AutomationProperties.AutomationId="Fullscreen" Content="全屏 · F11" Click="Fullscreen"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
  </Grid>
</NavigationView>
</Grid>
</Window>
